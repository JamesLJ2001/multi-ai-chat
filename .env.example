# Local-only secrets. Copy this file to `.env`, fill in the real keys there, and never commit them.
# If all three keys are empty, the app falls back to built-in mock responses.

DEEPSEEK_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=

DEEPSEEK_MODEL=deepseek-reasoner
GEMINI_MODEL=gemini-2.5-pro
XAI_MODEL=grok-3

# Optional advanced override. Keep secrets in env vars and reference them with `apiKeyEnv`.
# AI_AGENTS_JSON=[{"id":"deepseek","name":"DeepSeek","provider":"openai-compatible","baseUrl":"https://api.deepseek.com/v1","model":"deepseek-reasoner","apiKeyEnv":"DEEPSEEK_API_KEY","accentColor":"#246b4f"},{"id":"gemini","name":"Gemini","provider":"gemini","model":"gemini-2.5-pro","apiKeyEnv":"GEMINI_API_KEY","accentColor":"#4c6fff"},{"id":"grok","name":"Grok","provider":"openai-compatible","baseUrl":"https://api.x.ai/v1","model":"grok-3","apiKeyEnv":"XAI_API_KEY","accentColor":"#111111"}]
AI_AGENTS_JSON=

# Optional. Required only when you want this project to run its own Cloudflare Tunnel
# connector via `docker compose --profile deploy up -d`.
CLOUDFLARED_TOKEN=
